{
  "name": "za_preselection",
  "function": {
    "module_name": "higgs_dna.analysis",
    "function_name": "run_analysis"
  },
  "tag_sequence": [
    {
      "module_name": "higgs_dna.taggers.za_tagger_merged",
      "tagger": "ZaTaggerRun3",
      "kwargs": {
        "name": "za_tagger_merged",
        "options": {
          "gen_info": {
            "calculate": true
          }
        }
      }
    }
  ],
  "systematics": {
    "weights": {
      "pu_reweight_sf": {
        "type": "event",
        "method": "from_function",
        "function": {
          "module_name": "higgs_dna.systematics.pileup_systematics",
          "name": "pu_reweight_sf"
        },
        "modify_central_weight": true,
        "requires_branches": [
          "Pileup_nTrueInt"
        ]
      },
      "hlt_sf": {
        "type": "event",
        "method": "from_function",
        "function": {
          "module_name": "higgs_dna.systematics.HLT_systematics",
          "name": "HLT_sf"
        },
        "modify_central_weight": true
      },
      "electron_wplid_sf": {
        "type": "object",
        "method": "from_function",
        "function": {
          "module_name": "higgs_dna.systematics.lepton_systematics",
          "name": "electron_WPL_sf"
        },
        "modify_central_weight": true,
        "input_collection": "Electron",
        "target_collections": [
          "SelectedElectron"
        ]
      },
      "electron_reco_sf": {
        "type": "object",
        "method": "from_function",
        "function": {
          "module_name": "higgs_dna.systematics.lepton_systematics",
          "name": "electron_reco_sf"
        },
        "modify_central_weight": true,
        "input_collection": "Electron",
        "target_collections": [
          "SelectedElectron"
        ]
      },
      "electron_wplid_sf_nomatch": {
        "type": "object",
        "method": "from_function",
        "function": {
          "module_name": "higgs_dna.systematics.lepton_systematics",
          "name": "electron_WPL_sf_nomatch"
        },
        "modify_central_weight": true,
        "input_collection": "SelectedGenNoRecoElectron",
        "target_collections": [
          "SelectedGenNoRecoElectron"
        ]
      },
      "muon_looseid_sf": {
        "type": "object",
        "method": "from_function",
        "function": {
          "module_name": "higgs_dna.systematics.lepton_systematics",
          "name": "muon_LooseID_sf"
        },
        "modify_central_weight": true,
        "input_collection": "Muon",
        "target_collections": [
          "SelectedMuon"
        ]
      },
      "muon_looseid_sf_nomatch": {
        "type": "object",
        "method": "from_function",
        "function": {
          "module_name": "higgs_dna.systematics.lepton_systematics",
          "name": "muon_LooseID_sf_nomatch"
        },
        "modify_central_weight": true,
        "input_collection": "SelectedGenNoRecoMuon",
        "target_collections": [
          "SelectedGenNoRecoMuon"
        ]
      },
      "muon_reco_sf": {
        "type": "object",
        "method": "from_function",
        "function": {
          "module_name": "higgs_dna.systematics.lepton_systematics",
          "name": "muon_reco_sf"
        },
        "modify_central_weight": true,
        "input_collection": "Muon",
        "target_collections": [
          "SelectedMuon"
        ]
      },
      "photon_id_sf": {
        "type": "object",
        "method": "from_function",
        "function": {
          "module_name": "higgs_dna.systematics.photon_systematics",
          "name": "photon_zaid_sf"
        },
        "modify_central_weight": true,
        "input_collection": "SelectedPhoton",
        "target_collections": [
          [
            "SelectedPhoton"
          ]
        ]
      },
      "photon_csev_sf": {
        "type": "object",
        "method": "from_function",
        "function": {
          "module_name": "higgs_dna.systematics.photon_systematics",
          "name": "photon_CSEV_sf"
        },
        "modify_central_weight": true,
        "input_collection": "SelectedPhoton",
        "target_collections": [
          [
            "SelectedPhoton"
          ]
        ]
      }
    },
    "independent_collections": {
      "FNUF": {
        "method": "from_function",
        "branch_modified": [
          "Photon",
          "pt"
        ],
        "function": {
          "module_name": "higgs_dna.systematics.photon_systematics",
          "name": "fnuf_unc"
        }
      },
      "Material": {
        "method": "from_function",
        "branch_modified": [
          "Photon",
          "pt"
        ],
        "function": {
          "module_name": "higgs_dna.systematics.photon_systematics",
          "name": "material_unc"
        }
      },
      "Photon_scale": {
        "method": "from_branch",
        "branch_modified": [
          "Photon",
          "pt"
        ],
        "branches": {
          "up": [
            "Photon",
            "pt_ScaleUp"
          ],
          "down": [
            "Photon",
            "pt_ScaleDown"
          ]
        }
      },
      "Photon_smear": {
        "method": "from_branch",
        "branch_modified": [
          "Photon",
          "pt"
        ],
        "branches": {
          "up": [
            "Photon",
            "dEsigmaUp"
          ],
          "down": [
            "Photon",
            "dEsigmaDown"
          ]
        },
        "additive": true
      },
      "Electron_scale": {
        "method": "from_branch",
        "branch_modified": [
          "Electron",
          "pt"
        ],
        "branches": {
          "up": [
            "Electron",
            "dEscaleUp"
          ],
          "down": [
            "Electron",
            "dEscaleDown"
          ]
        }
      },
      "Electron_smear": {
        "method": "from_branch",
        "branch_modified": [
          "Electron",
          "pt"
        ],
        "branches": {
          "up": [
            "Electron",
            "dEsigmaUp"
          ],
          "down": [
            "Electron",
            "dEsigmaDown"
          ]
        },
        "additive": true
      },
      "Muon_scale": {
        "method": "from_branch",
        "branch_modified": [
          "Muon",
          "pt"
        ],
        "branches": {
          "up": [
            "Muon",
            "scaleUp_pt"
          ],
          "down": [
            "Muon",
            "scaleDown_pt"
          ]
        }
      },
      "Muon_smear": {
        "method": "from_branch",
        "branch_modified": [
          "Muon",
          "pt"
        ],
        "branches": {
          "up": [
            "Muon",
            "smearUp_pt"
          ],
          "down": [
            "Muon",
            "smearDown_pt"
          ]
        },
        "additive": true
      }
    }
  },
