universe = vanilla
executable = /afs/cern.ch/work/p/pelai/HZa/HiggsZaAna/studies/combine_review_20261105/an_round2/impact_bonly/runjob_impact_bonly.sh
getenv = False
request_memory = 3000
request_cpus = 1
+JobFlavour = "tomorrow"
batch_name = HZa_review_r2_impact_bonly
on_exit_hold = (ExitBySignal == True) || (ExitCode != 0)
periodic_release = (NumJobStarts < 3) && ((CurrentTime - EnteredCurrentStatus) > 600)
log = /afs/cern.ch/work/p/pelai/HZa/HiggsZaAna/studies/combine_review_20261105/an_round2/logs/impact/impact.$(ClusterId).log
environment = "IMPACT_CARD=xsec IMPACT_EXPECT=0 IMPACT_PARALLEL=1 IMPACT_SKIP_T2W=1 IMPACT_FIX_INDEX=1 IMPACT_RANGES=prod IMPACT_RABS=3.0469"
output = /afs/cern.ch/work/p/pelai/HZa/HiggsZaAna/studies/combine_review_20261105/an_round2/logs/impact/xsec_mA1.$(ClusterId).out
error = /afs/cern.ch/work/p/pelai/HZa/HiggsZaAna/studies/combine_review_20261105/an_round2/logs/impact/xsec_mA1.$(ClusterId).err
arguments = 1 /afs/cern.ch/work/p/pelai/HZa/flashgg_run3/CMSSW_14_1_0_pre4/src/flashggFinalFit /afs/cern.ch/work/p/pelai/HZa/flashgg_run3/CMSSW_14_1_0_pre4
queue

