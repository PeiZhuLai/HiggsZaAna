universe       = vanilla
executable     = /afs/cern.ch/work/p/pelai/HZa/HiggsZaAna/studies/combine_review_20261105/range_mA1_2/bias/runjob.sh
request_memory = 3000
request_cpus   = 1
+JobFlavour    = "workday"
batch_name     = bias_screen_cap113_mA2
on_exit_hold   = (ExitBySignal == True) || (ExitCode != 0)
periodic_release = (NumJobStarts < 3) && ((CurrentTime - EnteredCurrentStatus) > 600)
output         = /dev/null
error          = /afs/cern.ch/work/p/pelai/HZa/HiggsZaAna/studies/combine_review_20261105/range_mA1_2/bias/logs/$(tag)_mA$(m)_$(tr)_$(inj)_c$(c).$(ClusterId).err
log            = /afs/cern.ch/work/p/pelai/HZa/HiggsZaAna/studies/combine_review_20261105/range_mA1_2/bias/logs/bias_screen.$(ClusterId).log
arguments      = $(tag) $(m) $(tr) $(inj) $(c) 1000
queue tag, m, tr, inj, c from (
