universe       = vanilla
executable     = /afs/cern.ch/work/p/pelai/HZa/HiggsZaAna/studies/combine_review_20261105/range_mA12_floor2/bias/runjob.sh
request_memory = 3000
request_cpus   = 1
+JobFlavour    = "workday"
batch_name     = bias_screen_fl2_mA12_steep
on_exit_hold   = (ExitBySignal == True) || (ExitCode != 0)
periodic_release = (NumJobStarts < 3) && ((CurrentTime - EnteredCurrentStatus) > 600)
output         = /dev/null
error          = /afs/cern.ch/work/p/pelai/HZa/HiggsZaAna/studies/combine_review_20261105/range_mA12_floor2/bias/logs/$(tag)_mA$(m)_$(tr)_$(inj)_c$(c).$(ClusterId).err
log            = /afs/cern.ch/work/p/pelai/HZa/HiggsZaAna/studies/combine_review_20261105/range_mA12_floor2/bias/logs/bias_screen.$(ClusterId).log
arguments      = $(tag) $(m) $(tr) $(inj) $(c) 1000
queue tag, m, tr, inj, c from (
fl2 12 Pow1steep 0 0
fl2 12 Pow1steep 0 1
fl2 12 Pow1steep 0 2
fl2 12 Pow1steep 0 3
fl2 12 Pow1steep 0 4
fl2 12 Pow1steep 0 5
fl2 12 Pow1steep 0 6
fl2 12 Pow1steep 0 7
fl2 12 Pow1steep 0 8
fl2 12 Pow1steep 0 9
fl2 12 Pow1steep q50 0
fl2 12 Pow1steep q50 1
fl2 12 Pow1steep q50 2
fl2 12 Pow1steep q50 3
fl2 12 Pow1steep q50 4
fl2 12 Pow1steep q50 5
fl2 12 Pow1steep q50 6
fl2 12 Pow1steep q50 7
fl2 12 Pow1steep q50 8
fl2 12 Pow1steep q50 9
)
