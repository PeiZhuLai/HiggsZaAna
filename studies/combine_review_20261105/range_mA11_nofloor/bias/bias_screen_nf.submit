universe       = vanilla
executable     = /afs/cern.ch/work/p/pelai/HZa/HiggsZaAna/studies/combine_review_20261105/range_mA11_nofloor/bias/runjob.sh
request_memory = 3000
request_cpus   = 1
+JobFlavour    = "workday"
batch_name     = bias_screen_nf
on_exit_hold   = (ExitBySignal == True) || (ExitCode != 0)
periodic_release = (NumJobStarts < 3) && ((CurrentTime - EnteredCurrentStatus) > 600)
output         = /dev/null
error          = /afs/cern.ch/work/p/pelai/HZa/HiggsZaAna/studies/combine_review_20261105/range_mA11_nofloor/bias/logs/$(tag)_mA$(m)_$(tr)_$(inj)_c$(c).$(ClusterId).err
log            = /afs/cern.ch/work/p/pelai/HZa/HiggsZaAna/studies/combine_review_20261105/range_mA11_nofloor/bias/logs/bias_screen.$(ClusterId).log
arguments      = $(tag) $(m) $(tr) $(inj) $(c) 1000
queue tag, m, tr, inj, c from (
nf 11 Pow1 q50 0
nf 11 Pow1 q50 1
nf 11 Pow1 q50 2
nf 11 Pow1 q50 3
nf 11 Pow1 q50 4
nf 11 Pow1 q50 5
nf 11 Pow1 q50 6
nf 11 Pow1 q50 7
nf 11 Pow1 q50 8
nf 11 Pow1 q50 9
nf 11 Lau1 q50 0
nf 11 Lau1 q50 1
nf 11 Lau1 q50 2
nf 11 Lau1 q50 3
nf 11 Lau1 q50 4
nf 11 Lau1 q50 5
nf 11 Lau1 q50 6
nf 11 Lau1 q50 7
nf 11 Lau1 q50 8
nf 11 Lau1 q50 9
nf 11 Exp1 q50 0
nf 11 Exp1 q50 1
nf 11 Exp1 q50 2
nf 11 Exp1 q50 3
nf 11 Exp1 q50 4
nf 11 Exp1 q50 5
nf 11 Exp1 q50 6
nf 11 Exp1 q50 7
nf 11 Exp1 q50 8
nf 11 Exp1 q50 9
nf 11 Bern5 q50 0
nf 11 Bern5 q50 1
nf 11 Bern5 q50 2
nf 11 Bern5 q50 3
nf 11 Bern5 q50 4
nf 11 Bern5 q50 5
nf 11 Bern5 q50 6
nf 11 Bern5 q50 7
nf 11 Bern5 q50 8
nf 11 Bern5 q50 9
)
