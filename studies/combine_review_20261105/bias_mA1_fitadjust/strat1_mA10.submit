# Side study (differs from production): strat1 (minimizer strategy 1, tolerance 0.001) refit of the x0 mA10 toys
# (same seeds as bias_inj x0 mA10 chunks 0-1), one truth function per job; checks the direction of the shift seen at mA1.
# Toy generation identical to production bias (production workspace root_t2w).
universe = vanilla
executable = /afs/cern.ch/work/p/pelai/HZa/HiggsZaAna/studies/combine_review_20261105/an_round2/bias_inj/runjob_bias_inj.sh
getenv = False
request_memory = 3000
request_cpus = 1
+JobFlavour = "tomorrow"
batch_name = HZa_bias_mA1_fitadjust
on_exit_hold = (ExitBySignal == True) || (ExitCode != 0)
periodic_release = (NumJobStarts < 3) && ((CurrentTime - EnteredCurrentStatus) > 600)

environment = "NTOYS_PER_CHUNK=1000 SELECT_FUNCTION=Bern5 INJ_E=0.0 INJ_IDX=0 BASE_DIR=/afs/cern.ch/work/p/pelai/HZa/flashgg_run3/CMSSW_14_1_0_pre4/src/flashggFinalFit BIAS_HS_ROOT=/afs/cern.ch/work/p/pelai/HZa/flashgg_run3/CMSSW_14_1_0_pre4/src/flashggFinalFit/Combine/Checks/Bias_nominal/bias_outputs_mA1_fitadjust/strat1 BIAS_FIT_COMBINE_OPTIONS='--cminDefaultMinimizerType Minuit2 --cminDefaultMinimizerStrategy 1 --cminDefaultMinimizerTolerance 0.001 --cminPreScan --cminFallbackAlgo Minuit2,0:0.1 --X-rtd MINIMIZER_freezeDisassociatedParams --X-rtd MINIMIZER_multiMin_hideConstants --X-rtd MINIMIZER_multiMin_maskConstraints --X-rtd MINIMIZER_multiMin_maskChannels=2 --freezeParameters MH --rMin -5 --rMax 5 --setParameterRanges r=-5,5'"
log = /afs/cern.ch/work/p/pelai/HZa/HiggsZaAna/studies/combine_review_20261105/bias_mA1_fitadjust/logs/strat1_mA10_Bern5_c0.$(ClusterId).log
output = /afs/cern.ch/work/p/pelai/HZa/HiggsZaAna/studies/combine_review_20261105/bias_mA1_fitadjust/logs/strat1_mA10_Bern5_c0.$(ClusterId).$(ProcId).out
error = /afs/cern.ch/work/p/pelai/HZa/HiggsZaAna/studies/combine_review_20261105/bias_mA1_fitadjust/logs/strat1_mA10_Bern5_c0.$(ClusterId).$(ProcId).err
arguments = 10 0 /afs/cern.ch/work/p/pelai/HZa/flashgg_run3/CMSSW_14_1_0_pre4/src/flashggFinalFit /afs/cern.ch/work/p/pelai/HZa/flashgg_run3/CMSSW_14_1_0_pre4
queue

