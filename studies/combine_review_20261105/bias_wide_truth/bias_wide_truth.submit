universe       = vanilla
executable     = /afs/cern.ch/work/p/pelai/HZa/HiggsZaAna/studies/combine_review_20261105/bias_wide_truth/runjob.sh
request_memory = 3000
request_cpus   = 1
+JobFlavour    = "longlunch"
batch_name     = bias_wide_truth
on_exit_hold   = (ExitBySignal == True) || (ExitCode != 0)
periodic_release = (NumJobStarts < 3) && ((CurrentTime - EnteredCurrentStatus) > 600)
output         = /dev/null
error          = /afs/cern.ch/work/p/pelai/HZa/HiggsZaAna/studies/combine_review_20261105/bias_wide_truth/logs/mA$(m)_$(inj)_c$(c).$(ClusterId).err
log            = /afs/cern.ch/work/p/pelai/HZa/HiggsZaAna/studies/combine_review_20261105/bias_wide_truth/logs/bias_wide_truth.$(ClusterId).log
arguments      = $(m) $(inj) $(c) 1000
