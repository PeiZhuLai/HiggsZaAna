arguments      = $(tag) $(m) $(tr) $(inj) $(c) 1000
queue tag, m, tr, inj, c from (
flr 28 Bern5 0 0
flr 28 Bern5 0 1
flr 28 Bern5 0 2
flr 28 Bern5 0 3
