# High-mass window training (user 2026-10-17: "high mA 如果也用SR training 呢"): production 16 inputs, signal of every training mass m_a 4-30 inside 115-133 GeV, vs the same inputs without window and the stored production scores. search_job.py = minscan3 copy (win_masses).
# High-mass minimal-change scan (user 2026-10-14): production 16 variables with one m_llgg variable dropped or swapped for an m_llgg-free one (no redefinition).
# Same payload and metrics as the variable search (bdt_varsearch/run_candidate.sh + search_job.py).
universe              = vanilla
executable            = /afs/cern.ch/work/p/pelai/HZa/HiggsZaAna/studies/l3_review_20260910/bdt_varsearch/run_candidate.sh
arguments             = $(IDX) /eos/home-p/pelai/HZa/bdt_varsearch_20261013/results/minscan_high_win_20261017 $(MODEL)
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files  = /afs/cern.ch/work/p/pelai/HZa/HiggsZaAna/studies/l3_review_20260910/varsearch_validate/minscan_high_win/code/search_job.py, /afs/cern.ch/work/p/pelai/HZa/HiggsZaAna/studies/l3_review_20260910/varsearch_validate/minscan_high_win/config.jsonl
transfer_output_files = ""
output                = /afs/cern.ch/work/p/pelai/HZa/HiggsZaAna/studies/l3_review_20260910/varsearch_validate/minscan_high_win/logs/job_$(IDX).out
error                 = /afs/cern.ch/work/p/pelai/HZa/HiggsZaAna/studies/l3_review_20260910/varsearch_validate/minscan_high_win/logs/job_$(IDX).err
log                   = /afs/cern.ch/work/p/pelai/HZa/HiggsZaAna/studies/l3_review_20260910/varsearch_validate/minscan_high_win/logs/cluster.log
request_cpus          = 1
request_memory        = 2000
request_disk          = 4000000
+JobFlavour           = "longlunch"
batch_name            = hza_minscan_high_win
on_exit_hold          = (ExitBySignal == True) || (ExitCode != 0)
periodic_release      = (NumJobStarts < 3) && ((CurrentTime - EnteredCurrentStatus) > 600)
queue IDX, MODEL from /afs/cern.ch/work/p/pelai/HZa/HiggsZaAna/studies/l3_review_20260910/varsearch_validate/minscan_high_win/args.txt
