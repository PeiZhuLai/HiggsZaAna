universe              = vanilla
executable            = /afs/cern.ch/work/p/pelai/HZa/HiggsZaAna/studies/l3_review_20260910/bdt_varsearch/run_candidate.sh
arguments             = $(IDX) /eos/home-p/pelai/HZa/bdt_varsearch_20261013/results/minscan_high_20261014 $(MODEL)
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files  = /afs/cern.ch/work/p/pelai/HZa/HiggsZaAna/studies/l3_review_20260910/bdt_varsearch/search_job.py, /afs/cern.ch/work/p/pelai/HZa/HiggsZaAna/studies/l3_review_20260910/varsearch_validate/minscan_high/config.jsonl
transfer_output_files = ""
output                = /afs/cern.ch/work/p/pelai/HZa/HiggsZaAna/studies/l3_review_20260910/varsearch_validate/minscan_high/logs/job_$(IDX).out
