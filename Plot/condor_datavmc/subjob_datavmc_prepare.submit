# dataVmc prepare (36 jobs: 6 sample groups x 3 regions x 2 tags)
universe        = vanilla
executable      = /afs/cern.ch/work/p/pelai/HZa/HiggsZaAna/Plot/condor_datavmc/runjob_datavmc_prepare.sh
getenv          = True
request_memory  = 8000
request_cpus    = 1
+JobFlavour     = "workday"
on_exit_hold    = (ExitBySignal == True) || (ExitCode != 0)
periodic_release = (NumJobStarts < 3) && ((CurrentTime - EnteredCurrentStatus) > 600)
batch_name      = dataVmc_prep

log       = /afs/cern.ch/work/p/pelai/HZa/HiggsZaAna/Plot/condor_datavmc/logs/prep_nominal_SR_data.$(ClusterId).log
output    = /afs/cern.ch/work/p/pelai/HZa/HiggsZaAna/Plot/condor_datavmc/logs/prep_nominal_SR_data.$(ClusterId).out
error     = /afs/cern.ch/work/p/pelai/HZa/HiggsZaAna/Plot/condor_datavmc/logs/prep_nominal_SR_data.$(ClusterId).err
arguments = SR nominal data Data
queue

log       = /afs/cern.ch/work/p/pelai/HZa/HiggsZaAna/Plot/condor_datavmc/logs/prep_nominal_SR_dyll.$(ClusterId).log
output    = /afs/cern.ch/work/p/pelai/HZa/HiggsZaAna/Plot/condor_datavmc/logs/prep_nominal_SR_dyll.$(ClusterId).out
error     = /afs/cern.ch/work/p/pelai/HZa/HiggsZaAna/Plot/condor_datavmc/logs/prep_nominal_SR_dyll.$(ClusterId).err
arguments = SR nominal dyll DYJetsToLL
queue

